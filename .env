# Daylist big data music platform runtime configuration
# Assumption: FastAPI, Spark, Kafka, Hive, and Redis run from Docker connected to the school cluster.
# The React frontend runs on Windows and reaches FastAPI through localhost:8000.

# -----------------------------------------------------------------------------
# FastAPI backend
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
APP_CACHE_ENABLED=false
ENABLE_NOTIFICATION_POLL=false

# CORS origins for browser clients. Use comma-separated values in code.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# Kafka
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=10.204.131.11:9092,10.84.128.10:9092
KAFKA_TOPIC_PLAY=music.events.play
KAFKA_TOPIC_SKIP=music.events.skip
KAFKA_TOPIC_LIKE=music.events.like
KAFKA_AUTO_OFFSET_RESET=latest
KAFKA_STARTING_OFFSETS=latest
KAFKA_FAIL_ON_DATA_LOSS=false
KAFKA_CREATE_TOPICS=false
KAFKA_START_WS_CONSUMER=true

# Workaround for school Kafka brokers that advertise localhost:9092 in metadata.
# This starts the same container-side forward you were running manually:
# socat TCP4-LISTEN:9092,bind=127.0.0.1,reuseaddr,fork TCP4:10.204.131.11:9092
KAFKA_LOCAL_FORWARD_ENABLED=true
KAFKA_LOCAL_FORWARD_BIND=127.0.0.1:9092
KAFKA_LOCAL_FORWARD_TARGET=10.204.131.11:9092
KAFKA_LOCAL_FORWARD_REQUIRED=true
KAFKA_LOCAL_FORWARD_READY_TIMEOUT_SECONDS=10

# -----------------------------------------------------------------------------
# Hive / HDFS
# -----------------------------------------------------------------------------
HIVE_SERVER2_IP=10.84.128.48
HIVE_SERVER2_PORT=10000
HIVE_DATABASE=francisco_jose_simoes
HIVE_USERNAME=hadoop

# Stable HDFS checkpoint path for Spark Structured Streaming.
SPARK_CHECKPOINT_LOCATION=/aulas/francisco_jose_simoes/project/checkpoints/music_events_play_v2
SPARK_CHECKPOINT_AUTOVERSION=true

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Use localhost if Redis runs inside the same container.
# Use host.docker.internal if Redis runs on Windows and backend/Spark run in Docker Desktop.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_RECS_TTL_SECONDS=86400
REDIS_CACHE_TTL_SECONDS=600

# -----------------------------------------------------------------------------
# Model training and speed layer
# -----------------------------------------------------------------------------
FEATURE_DIR=./mbdump_small/features
MODEL_DIR=./mbdump_small/models
MODEL_PATH=./mbdump_small/models/als_model.pkl
FEATURE_PATH=./mbdump_small/features/implicit.tsv

ALS_FACTORS=32
ALS_ITERATIONS=20
ALS_REGULARIZATION=0.001
RANDOM_STATE=42
EVAL_TOP_K=10
PRECOMPUTE_TOP_N=50
WRITE_REDIS_PRECOMPUTED=true

# Keep this bounded because spark_streaming.py currently uses toPandas() per micro-batch.
MAX_STREAM_BATCH_EVENTS=5000

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# Vite only loads these automatically from frontend/.env* when npm runs inside frontend/.
# Keep the values here as the canonical project config, or duplicate them into frontend/.env.local.
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
